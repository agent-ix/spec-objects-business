{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-ix.org/agent-ix/spec-objects-business/0.7.0/NestedEntity.json",
  "type": "object",
  "properties": {
    "fields": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.agent-ix.org/semantic-core/0.2.0/FieldDecl.json"
      },
      "minItems": 1,
      "contains": {
        "$ref": "https://schemas.agent-ix.org/agent-ix/spec-objects-business/0.7.0/IdentityField.json"
      }
    },
    "owner": {
      "$ref": "https://schemas.agent-ix.org/semantic-core/0.2.0/RelationDecl.json"
    },
    "clauses": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.agent-ix.org/semantic-core/0.2.0/ClauseRef.json"
      }
    },
    "operations": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.agent-ix.org/semantic-core/0.2.0/OperationDecl.json"
      }
    }
  },
  "required": [
    "fields"
  ],
  "unevaluatedProperties": {
    "not": {}
  },
  "description": "An entity whose identity is local to its owner. `relations` is forbidden by\nthe seal: a nested entity is reached through its owner. Identity locality is\nprose the schema does not express."
}
